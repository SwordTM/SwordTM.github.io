---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, postItem } from '../../lib/posts';

const items = (await getPosts()).map(postItem);
---

<Base title="Writing">
  <div class="page">
    <h1>Writing</h1>
    <PostList items={items} />
  </div>
</Base>
