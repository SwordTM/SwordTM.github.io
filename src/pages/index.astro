---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Mark from '../components/Mark.astro';
import { site } from '../site.config';
import { getPosts, postItem, projectItems } from '../lib/posts';

const posts = (await getPosts()).map(postItem);
const projects = projectItems();
---

<Base>
  <div class="home">
    <Mark />

    <p class="intro" set:html={site.intro} />

    <input id="search" type="search" placeholder="Search…" autocomplete="off" aria-label="Search posts and projects" />

    <div class="sections">
      {posts.length > 0 && <PostList title="Writing" items={posts} />}
      {projects.length > 0 && <PostList title="Projects" items={projects} />}
    </div>
    <p id="no-results" hidden>Nothing matches that search.</p>
  </div>
</Base>

<script>
  const input = document.getElementById('search') as HTMLInputElement;
  const empty = document.getElementById('no-results')!;
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let any = false;
    document.querySelectorAll<HTMLElement>('.sections .entries').forEach((section) => {
      let shown = 0;
      section.querySelectorAll<HTMLElement>('li').forEach((li) => {
        const match = !q || li.dataset.search!.includes(q);
        li.hidden = !match;
        if (match) shown++;
      });
      section.hidden = shown === 0;
      if (shown) any = true;
    });
    empty.hidden = any;
  });
</script>
