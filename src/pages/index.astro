---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import Mark from '../components/Mark.astro';
import { site } from '../site.config';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const toItem = (p: (typeof posts)[number]) => ({
  title: p.data.title,
  href: `/posts/${p.id}/`,
  year: p.data.date.getUTCFullYear(),
});

const sections = [
  { title: 'Featured', items: posts.filter((p) => p.data.featured).map(toItem) },
  { title: 'Recent', items: posts.slice(0, 6).map(toItem) },
  ...site.categories.map((c) => ({
    title: c,
    items: posts.filter((p) => p.data.categories.includes(c)).map(toItem),
  })),
  {
    title: 'Projects',
    items: site.projects.map((p) => ({ title: p.name, href: p.url, year: p.year })),
  },
].filter((s) => s.items.length > 0);
---

<Base>
  <div class="home">
    <Mark />

    <p class="intro" set:html={site.intro} />

    <input id="search" type="search" placeholder="Search posts…" autocomplete="off" aria-label="Search posts" />

    <div class="sections">
      {sections.map((s) => <PostList title={s.title} items={s.items} />)}
    </div>
    <p id="no-results" hidden>Nothing matches that search.</p>
  </div>
</Base>

<script>
  const input = document.getElementById('search') as HTMLInputElement;
  const empty = document.getElementById('no-results')!;
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let any = false;
    document.querySelectorAll<HTMLElement>('.sections .post-list').forEach((section) => {
      let shown = 0;
      section.querySelectorAll<HTMLElement>('li').forEach((li) => {
        const match = !q || li.dataset.title!.includes(q);
        li.hidden = !match;
        if (match) shown++;
      });
      section.hidden = shown === 0;
      if (shown) any = true;
    });
    empty.hidden = any;
  });
</script>
