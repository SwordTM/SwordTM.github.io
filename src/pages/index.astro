---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { site } from '../site.config';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
const toItem = (p: (typeof posts)[number]) => ({
  title: p.data.title,
  href: `/posts/${p.id}/`,
  year: p.data.date.getUTCFullYear(),
});

const sections = [
  { title: 'Featured', items: posts.filter((p) => p.data.featured).map(toItem) },
  { title: 'Recent', items: posts.slice(0, 6).map(toItem) },
  ...site.categories.map((c) => ({
    title: c,
    items: posts.filter((p) => p.data.categories.includes(c)).map(toItem),
  })),
  {
    title: 'Projects',
    items: site.projects.map((p) => ({ title: p.name, href: p.url, year: p.year })),
  },
].filter((s) => s.items.length > 0);
---

<Base>
  <div class="home">
    <svg class="mark" viewBox="0 0 96 96" width="96" height="96" aria-hidden="true">
      {
        // A small lattice of nodes and edges: a stand-in logo. Swap for your own image if you like.
        [0, 1, 2, 3].flatMap((r) =>
          [0, 1, 2, 3].flatMap((c) => {
            const x = 12 + c * 24, y = 12 + r * 24;
            const out = [<circle cx={x} cy={y} r={(r * 3 + c * 5) % 4 === 0 ? 3.2 : 1.8} fill="currentColor" />];
            if (c < 3 && (r + c) % 2 === 0) out.push(<line x1={x} y1={y} x2={x + 24} y2={y} stroke="currentColor" stroke-width="0.8" />);
            if (r < 3 && (r * 2 + c) % 3 !== 0) out.push(<line x1={x} y1={y} x2={x} y2={y + 24} stroke="currentColor" stroke-width="0.8" />);
            if (r < 3 && c < 3 && (r + 2 * c) % 4 === 1) out.push(<line x1={x} y1={y} x2={x + 24} y2={y + 24} stroke="currentColor" stroke-width="0.8" />);
            return out;
          }),
        )
      }
    </svg>

    <p class="intro" set:html={site.intro} />

    <input id="search" type="search" placeholder="Search posts…" autocomplete="off" aria-label="Search posts" />

    <div class="sections">
      {sections.map((s) => <PostList title={s.title} items={s.items} />)}
    </div>
    <p id="no-results" hidden>Nothing matches that search.</p>
  </div>
</Base>

<script>
  const input = document.getElementById('search') as HTMLInputElement;
  const empty = document.getElementById('no-results')!;
  input.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let any = false;
    document.querySelectorAll<HTMLElement>('.sections .post-list').forEach((section) => {
      let shown = 0;
      section.querySelectorAll<HTMLElement>('li').forEach((li) => {
        const match = !q || li.dataset.title!.includes(q);
        li.hidden = !match;
        if (match) shown++;
      });
      section.hidden = shown === 0;
      if (shown) any = true;
    });
    empty.hidden = any;
  });
</script>
